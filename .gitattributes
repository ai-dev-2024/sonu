# Normalize line endings: LF everywhere except Windows-specific files
* text=auto eol=lf

# Windows-only files may keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.msi binary
*.dmg binary
*.appimage binary
*.deb binary
*.rpm binary
