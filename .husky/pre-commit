#!/bin/sh
# Pre-commit hook for SONU

. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any JavaScript/TypeScript files are staged
if echo "$STAGED_FILES" | grep -E "\.(js|jsx|ts|tsx)$" > /dev/null; then
    echo "📦 Checking Tauri app..."
    cd apps/tauri-v2 || exit 1
    
    echo "  - Running ESLint..."
    bun run lint || exit 1
    
    echo "  - Running Prettier (check only)..."
    # `format` would rewrite files during the commit without re-staging them,
    # so the commit could still land unformatted and fail CI's format:check.
    # Fail here instead and let the author run `bun run format`.
    bun run format:check || exit 1
    
    echo "  - Running TypeScript check..."
    bun run typecheck || exit 1
    
    cd ../..
fi

# Check if any Rust files are staged
if echo "$STAGED_FILES" | grep -E "\.rs$" > /dev/null; then
    echo "🦀 Checking Rust code..."
    cd apps/tauri-v2/src-tauri || exit 1
    
    echo "  - Running cargo fmt..."
    cargo fmt -- --check || exit 1
    
    echo "  - Running clippy..."
    cargo clippy -- -D warnings || exit 1
    
    cd ../../..
fi

# Check if any Python files are staged (for legacy app)
if echo "$STAGED_FILES" | grep -E "\.py$" > /dev/null; then
    echo "🐍 Python files staged, but the legacy desktop app has been removed."
    echo "   (apps/desktop/src/core/python/ no longer exists — skipping.)"
fi

echo "✅ All checks passed!"
